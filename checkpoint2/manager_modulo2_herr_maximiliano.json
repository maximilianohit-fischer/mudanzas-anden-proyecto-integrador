    {
      "id": "fb21bbd3-b147-4b75-932b-e92861a494d2",
      "name": "Taxonomía cerrada (JSON)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        400,
        580
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intencion\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"PEDIDO_MUDANZA\",\n        \"CONSULTA_COMERCIAL\",\n        \"RECLAMO\",\n        \"FUERA_DE_AMBITO\",\n        \"DUDOSA\"\n      ]\n    },\n    \"confianza\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"motivo\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"intencion\",\n    \"confianza\",\n    \"motivo\"\n  ]\n}"
      }
    },
